# ===== Bắt buộc =====
ADMIN_USER=admin
ADMIN_PASSWORD=
# DATABASE_URL tự có khi kết nối Neon trong Vercel
# Mật khẩu bí mật để web bot chat gửi đơn sang đây (tự đặt chuỗi dài, dùng CHUNG với web bot chat)
SHARED_SECRET=

# ===== Nối ngược về web bot chat (báo tình trạng đơn) =====
BOT_WEB_URL=https://ten-web-bot-chat.vercel.app

# ===== Chế độ thử: 1 = giả lập, KHÔNG gọi J&T thật (mặc định bật cho tới khi bạn có tài khoản J&T) =====
CARRIER_MOCK=1

# ===== Thông tin J&T (J&T cấp cho bạn) =====
JNT_API_BASE=
JNT_ECCOMPANYID=
JNT_CUSTOMERID=
JNT_KEY=
# Địa chỉ kho gửi hàng của shop
SENDER_NAME=
SENDER_PHONE=
SENDER_ADDRESS=
SENDER_WARD=
SENDER_DISTRICT=
SENDER_PROVINCE=
